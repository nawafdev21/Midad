---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import TagList from "../../components/TagList.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import {
  getPublishedPosts,
  getRelatedPosts,
  estimateReadingTime,
  formatReadingTime,
  formatArabicDate,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, author, date, cover, description, sources, tags } = post.data;
const { Content } = await render(post);

const allPosts = await getPublishedPosts();
const relatedPosts = getRelatedPosts(post, allPosts);

const readingTime = post.data.readingTime ?? estimateReadingTime(post.body ?? "");
const formattedDate = formatArabicDate(date);
---

<Layout title={title} description={description} image={cover.src}>
  <article class="wrap">
    <h1>{title}</h1>
    <p class="meta">
      <a href={`/author/${author}`} class="author-link">{author}</a> · {formattedDate} · {formatReadingTime(readingTime)} قراءة
    </p>

    <Image src={cover} alt={title} width={900} height={500} class="cover" />

    <div class="content">
      <Content />
    </div>

    {sources && sources.length > 0 && (
      <section class="sources">
        <h2>المصادر</h2>
        <ul>
          {sources.map((source) => <li>{source}</li>)}
        </ul>
      </section>
    )}

    <TagList tags={tags} />

    <RelatedPosts posts={relatedPosts} />
  </article>
</Layout>

<style>
  .wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  h1 {
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .meta {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin: 0 0 32px;
  }

  .author-link {
    color: inherit;
    text-decoration: none;
  }

  .author-link:hover {
    color: var(--color-accent);
  }

  .cover {
    width: 100%;
    border-radius: var(--radius-card);
    margin-bottom: 32px;
  }

  .content {
    line-height: 1.9;
  }

  .content :global(h2),
  .content :global(h3) {
    font-weight: 500;
  }

  .content :global(blockquote) {
    border-inline-start: 3px solid var(--color-accent);
    margin: 24px 0;
    padding-inline-start: 16px;
    color: var(--color-text-secondary);
  }

  .content :global(img) {
    border-radius: var(--radius-card);
  }

  .sources {
    margin: 40px 0;
    border-top: 0.5px solid var(--color-border);
    padding-top: 24px;
  }

  .sources h2 {
    font-size: 1rem;
  }

  .sources ul {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
</style>
