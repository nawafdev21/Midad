---
import { SITE_NAME, SOCIAL_LINKS } from "../config";
import NewsletterForm from "./NewsletterForm.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="col">
      <a href="/" class="wordmark">{SITE_NAME}</a>
      <ul class="socials">
        {SOCIAL_LINKS.map((link) => (
          <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="col newsletter-col">
      <NewsletterForm />
    </div>
  </div>

  <div class="copyright">
    <p>© {year} {SITE_NAME}. جميع الحقوق محفوظة.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 0.5px solid var(--color-border);
    margin-top: 80px;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 24px;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .newsletter-col {
    min-width: 340px;
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .socials {
    list-style: none;
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
  }

  .socials a {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .socials a:hover {
    color: var(--color-accent);
  }

  .copyright {
    border-top: 0.5px solid var(--color-border);
    padding: 20px 24px;
    text-align: center;
  }

  .copyright p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }
</style>
