---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tag-list">
  {tags.map((tag) => (
    <li>
      <a href={`/blog/tags/${tag}`}>{tag}</a>
    </li>
  ))}
</ul>

<style>
  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    border: 0.5px solid var(--color-border);
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
</style>
