---
import { SITE_NAME, NAV_LINKS } from "../config";
---

<header class="site-header">
  <div class="wrap">
    <a href="/" class="wordmark">{SITE_NAME}</a>

    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">
      <span></span>
    </button>

    <nav id="nav-links" class="nav-links">
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 0.5px solid var(--color-border);
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    content: "";
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    position: relative;
  }

  .menu-toggle span::before {
    top: -8px;
  }

  .menu-toggle span::after {
    top: 6px;
  }

  @media (max-width: 640px) {
    .menu-toggle {
      display: block;
    }

    .nav-links {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 0.5px solid var(--color-border);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 14px 24px;
      border-top: 0.5px solid var(--color-border);
    }

    .wrap {
      position: relative;
    }
  }
</style>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const nav = document.getElementById("nav-links");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
