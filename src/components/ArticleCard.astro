---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatArabicDate } from "../lib/posts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, author, date, cover, tags } = post.data;
const formattedDate = formatArabicDate(date);
---

<div class="article-card">
  <a href={`/post/${post.data.slug}`} class="cover-link">
    <Image src={cover} alt={title} width={330} height={220} class="cover" />
  </a>
  <div class="body">
    {tags[0] && <span class="tag">{tags[0]}</span>}
    <h3 class="title"><a href={`/post/${post.data.slug}`}>{title}</a></h3>
    <p class="meta">
      <a href={`/author/${author}`} class="author-link">{author}</a> · {formattedDate}
    </p>
  </div>
</div>

<style>
  .article-card {
    display: block;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .title a {
    text-decoration: none;
    color: inherit;
  }

  .author-link {
    color: inherit;
    text-decoration: none;
  }

  .author-link:hover {
    color: var(--color-accent);
  }

  .cover {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tag {
    align-self: start;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }
</style>
